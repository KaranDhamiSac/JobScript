{
  "manifest_version": 3,
  "name": "JobScript",
  "version": "0.1.0",
  "description": "Autofill job applications on Greenhouse and Lever from your saved profile. Never submits for you.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://jobs.smartrecruiters.com/*"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/storage.js",
      "lib/ai.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "JobScript",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Fill this page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": [
        "lib/storage.js",
        "lib/fieldMap.js",
        "lib/dateRules.js",
        "content/panel.js",
        "content/bank.js",
        "content/autofill.js"
      ],
      "css": [
        "content/autofill.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' https://api.anthropic.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jobscript@jobscript.local",
      "strict_min_version": "128.0"
    }
  }
}
